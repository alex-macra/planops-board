{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/alex-macra/planops-board/main/schema/config.schema.json",
  "title": "PlanOps Board configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "documents", "workflow", "git", "server"],
  "properties": {
    "version": {
      "enum": [1, 2]
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)(?!.*\\*{3})(?!.*[?{}()!+@])(?!.*\\[)(?!.*\\])(?!.*//)(?!.*\\\\).+\\.[mM][dD]$"
          }
        },
        "exclude": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)(?!.*\\*{3})(?!.*[?{}()!+@])(?!.*\\[)(?!.*\\])(?!.*//)(?!.*\\\\).+$"
          }
        },
        "writable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)(?!.*[?{}()!+@])(?!.*\\[)(?!.*\\])(?!.*//)(?!.*\\\\).+\\.[mM][dD]$",
            "not": {
              "anyOf": [
                { "pattern": "^(?:\\s|\\./)" },
                { "pattern": "/\\./" },
                { "pattern": "[\\u0000-\\u001f\\u007f\\u2028\\u2029]" },
                { "pattern": "\\s$" }
              ]
            }
          }
        }
      }
    },
    "projectsFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statusOrder",
        "activeStatuses",
        "blockedStatuses",
        "closedStatuses",
        "dependencySatisfiedStatuses",
        "priorityOrder"
      ],
      "properties": {
        "statusOrder": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "activeStatuses": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "blockedStatuses": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "closedStatuses": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "dependencySatisfiedStatuses": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "priorityOrder": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectedBranches", "commitEnabled"],
      "properties": {
        "protectedBranches": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "commitEnabled": {
          "type": "boolean"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } } },
      "then": {
        "properties": {
          "documents": { "type": "object", "properties": { "writable": false } }
        }
      },
      "else": {
        "properties": {
          "documents": {
            "type": "object",
            "required": ["writable"],
            "properties": { "writable": true }
          }
        }
      }
    }
  ],
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
